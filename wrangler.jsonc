{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameschooling",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gameschooling",
      "database_id": "0d1c7200-5db1-4b80-acee-f249b8e33c83",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "gameschooling" }],
  // Re-seed the Demo Family every night (03:00 GMT+7).
  "triggers": { "crons": ["0 20 * * *"] },
  "vars": {
    "PLANNER_MODEL": "muse-wonder-1.0",
    "PLANNER_FALLBACK_MODEL": "muse-spark-1.3",
  },
  // Secrets (wrangler secret put / .dev.vars): MODEL_API_KEY, BASETEN_API_KEY,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET, BETTER_AUTH_URL
}
