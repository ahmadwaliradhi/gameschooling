{
  "name": "gameschooling",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler d1 migrations apply gameschooling --remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gameschooling --local",
    "check": "oxlint && oxfmt --check && tsc --noEmit && vitest run",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.dev.vars scripts/smoke.ts",
    "seed": "pnpm db:migrate:local && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.67.0",
    "openai": "^7.47.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@libsql/client": "^0.18.0",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
